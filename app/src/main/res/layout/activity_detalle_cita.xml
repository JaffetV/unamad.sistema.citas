<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión de Cita"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvDetalleCliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetalleServicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetallePrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetalleFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetalleEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnMarcarAtendido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MARCAR COMO ATENDIDO"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnMarcarCancelado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR CITA"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEliminarCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ ELIMINAR DE BASE DE DATOS"
        android:backgroundTint="#D32F2F" />

</LinearLayout>